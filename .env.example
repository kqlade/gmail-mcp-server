# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# Security
TOKEN_ENCRYPTION_KEY=generate-a-32-byte-key-here
# Capability tokens, sent as `Authorization: Bearer <token>`.
# Entries are id:token:account:read or id:token:account:write. Use the same id
# and account twice with different random tokens; the server advertises and
# executes only that token's tools. Comma- or newline-separated.
MCP_AUTH_TOKENS=ola:generate-a-read-token-here:ola@example.com:read,ola:generate-a-write-token-here:ola@example.com:write
# Legacy single caller ("primary"), optionally pinned with GMAIL_ACCOUNT. It
# may temporarily overlap capability credentials for `primary` during cutover;
# remove the legacy token after clients have switched.
# MCP_AUTH_TOKEN=generate-a-secure-token-here
# GMAIL_ACCOUNT=you@example.com

# Database (optional - defaults to ./data/gmail-mcp.db)
DB_URL=./data/gmail-mcp.db

# CORS (optional - comma-separated list of allowed origins)
ALLOWED_ORIGINS=
